# Copiez ce fichier vers .env.local puis renseignez les valeurs réelles.
# .env.local est ignoré par git — ne commitez JAMAIS de clés réelles.
#
# Les valeurs se trouvent dans Supabase : Project Settings > API Keys.
# Le projet utilise le format d'API keys actuel (sb_publishable_… / sb_secret_…)
# et non les anciennes clés JWT anon / service_role.

# URL du projet Supabase (exposée au navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé "publishable" (exposée au navigateur — protégée par le RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Clé "secret" — CONTOURNE LE RLS.
# Usage serveur uniquement (Server Actions / Route Handlers). Ne jamais la
# préfixer par NEXT_PUBLIC_ ni l'importer depuis un Composant Client.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Nom du bucket Supabase Storage hébergeant le logo du parti (section Paramètres)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=public-assets

# --- Envoi du rapport Excel par e-mail (voir docs/cron-setup.md) ---

# Clé d'API Resend. Sans elle, le bouton « إرسال بالبريد الإلكتروني » signale
# une erreur au clic et la tâche planifiée n'envoie rien.
RESEND_API_KEY=your_resend_api_key_here

# Expéditeur. Facultatif : par défaut « onboarding@resend.dev », le domaine de
# test de Resend, qui n'accepte d'écrire qu'au titulaire du compte. Pour
# écrire à un tiers, vérifiez un domaine chez Resend et renseignez-le ici.
# REPORT_FROM_EMAIL=Rapports <rapports@mondomaine.ma>

# Secret partagé avec le planificateur Vercel, qui l'envoie en en-tête
# « Authorization: Bearer … ». Une chaîne aléatoire longue :
#   openssl rand -hex 32
# S'il est absent, /api/cron/send-report refuse TOUTES les requêtes.
CRON_SECRET=dev-secret-local-a1b2c3d4e5f6

# --- Optionnel : outillage local (CLI Supabase, migrations) ---
# Chaîne de connexion PostgreSQL directe. Le mot de passe doit être
# URL-encodé (ex. « @ » devient « %40 »).
# DATABASE_URL=postgresql://postgres:MOT_DE_PASSE_ENCODE@db.xxxxxxxx.supabase.co:5432/postgres

